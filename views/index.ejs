<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <main class="container">
      <h1><%= title %></h1>
      <p><%= message %></p>
      <div class="pathsList">
        <% 
          list.sort((a, b) => {
            const matchA = a.match(/^([a-zA-Z]+)(\d+)/);
            const matchB = b.match(/^([a-zA-Z]+)(\d+)/);
            if (!matchA) return 1;
            if (!matchB) return -1;
            return parseInt(matchA[2], 10) - parseInt(matchB[2], 10);
          });
          list.forEach((page, index) => { 
          const match = page.match(/^([a-zA-Z]+)(\d+)/); %>
          <% if (match && match[1] === 'sect') { %>
            <a href="/Paths/<%= page %>"><%= match[2] %></a>
          <% } %>
        <% }); %>
      </div>
    </main>
  </body>
</html>
